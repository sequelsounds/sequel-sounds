{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTrackPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::sequel-sounds-media",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["tracks/*"]
        }
      }
    },
    {
      "Sid": "DeleteTrackObjects",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::sequel-sounds-media/tracks/*"
    }
  ]
}
