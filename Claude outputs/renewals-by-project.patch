-      const { error } = await rpc('track_mark_renewal_seen', { p_uuid: uuid, p_seen: seen })
+    mutationFn: async ({ uuids, seen }: { uuids: string[]; seen: boolean }) => {
+      const { error } = await rpc('track_mark_renewals_seen', { p_uuids: uuids, p_seen: seen })
